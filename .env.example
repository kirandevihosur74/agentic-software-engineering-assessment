TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=engineering-v1
# Set an absolute path shared by workers; .env is not auto-loaded.
ARTIFACT_ROOT=artifacts
# Optional Claude worker configuration; set the API key securely outside this file.
CLAUDE_MODEL=sonnet
CLAUDE_MAX_BUDGET_USD=1.00
CLAUDE_TIMEOUT_SECONDS=180
# Build the supplied test image and start Docker before Claude runs.
ENGINEERING_TEST_IMAGE=engineering-tests:local

# Worker-only trust file; reviewer CLI private key belongs outside the project.
# ENGINEERING_APPROVAL_KEYS=/absolute/private/trusted-reviewers.json
# ENGINEERING_APPROVAL_PRIVATE_KEY=/absolute/private/reviewer.pem
