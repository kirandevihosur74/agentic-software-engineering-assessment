--- baseline/tests/test_ttl.py
+++ proposed/tests/test_ttl.py
@@ -0,0 +1,78 @@
+import pytest
+from fastapi.testclient import TestClient
+
+from app.main import create_app
+
+URL = "https://example.com/x"
+
+
+class Clock:
+    def __init__(self, t=1000.0):
+        self.t = t
+
+    def __call__(self):
+        return self.t
+
+
+@pytest.fixture
+def clock():
+    return Clock()
+
+
+@pytest.fixture
+def c(db_path, clock):
+    return TestClient(create_app(db_path, clock=clock))
+
+
+def make(c, ttl):
+    return c.post("/links", json={"url": URL, "ttl_seconds": ttl})
+
+
+@pytest.mark.parametrize("ttl", [True, False, "10", 5.0, 1.5, 0, -1, 86401, None, [1]])
+def test_invalid_ttl(c, ttl):
+    assert make(c, ttl).status_code == 422
+
+
+@pytest.mark.parametrize("ttl", [1, 86400])
+def test_valid_ttl_bounds(c, ttl):
+    assert make(c, ttl).status_code == 201
+
+
+def test_non_expiring(c, clock):
+    code = c.post("/links", json={"url": URL}).json()["code"]
+    clock.t = 10**10
+    assert c.get(f"/r/{code}", follow_redirects=False).status_code == 302
+    assert c.get(f"/links/{code}/stats").json()["expires_at"] is None
+
+
+def test_boundary(c, clock):
+    code = make(c, 10).json()["code"]
+    assert c.get(f"/links/{code}/stats").json()["expires_at"] == 1010.0
+    clock.t = 1009
+    assert c.get(f"/r/{code}", follow_redirects=False).status_code == 302
+    clock.t = 1010
+    assert c.get(f"/r/{code}", follow_redirects=False).status_code == 404
+    clock.t = 2000
+    assert c.get(f"/r/{code}", follow_redirects=False).status_code == 404
+
+
+def test_expired_clicks_not_counted_and_stats_available(c, clock):
+    code = make(c, 5).json()["code"]
+    c.get(f"/r/{code}", follow_redirects=False)
+    clock.t = 1005
+    for _ in range(3):
+        assert c.get(f"/r/{code}", follow_redirects=False).status_code == 404
+    r = c.get(f"/links/{code}/stats")
+    assert r.status_code == 200
+    assert r.json() == {"code": code, "url": URL, "clicks": 1, "expires_at": 1005.0}
+
+
+def test_fractional_boundary(db_path):
+    clock = Clock(1000.5)
+    c = TestClient(create_app(db_path, clock=clock))
+    code = make(c, 1).json()["code"]
+    assert c.get(f"/links/{code}/stats").json()["expires_at"] == 1001.5
+    clock.t = 1001.4999
+    assert c.get(f"/r/{code}", follow_redirects=False).status_code == 302
+    clock.t = 1001.5
+    assert c.get(f"/r/{code}", follow_redirects=False).status_code == 404
--- baseline/tests/test_migration.py
+++ proposed/tests/test_migration.py
@@ -0,0 +1,43 @@
+import sqlite3
+
+from fastapi.testclient import TestClient
+
+from app.db import init_db
+from app.main import create_app
+
+
+def legacy(path):
+    conn = sqlite3.connect(path)
+    conn.execute("CREATE TABLE links (code TEXT PRIMARY KEY, url TEXT NOT NULL, clicks INTEGER NOT NULL DEFAULT 0)")
+    conn.execute("INSERT INTO links VALUES ('OLDCODE', 'https://old.example/', 7)")
+    conn.execute("INSERT INTO links VALUES ('OLD2222', 'https://old2.example/', 0)")
+    conn.commit()
+    conn.close()
+
+
+def rows(path):
+    conn = sqlite3.connect(path)
+    try:
+        return conn.execute("SELECT code, url, clicks, expires_at FROM links ORDER BY code").fetchall()
+    finally:
+        conn.close()
+
+
+def test_migration_preserves_data_and_is_idempotent(db_path):
+    legacy(db_path)
+    init_db(db_path)
+    init_db(db_path)
+    assert rows(db_path) == [
+        ("OLD2222", "https://old2.example/", 0, None),
+        ("OLDCODE", "https://old.example/", 7, None),
+    ]
+
+
+def test_legacy_links_still_work(db_path):
+    legacy(db_path)
+    create_app(db_path)
+    c = TestClient(create_app(db_path, clock=lambda: 10**12))
+    r = c.get("/r/OLDCODE", follow_redirects=False)
+    assert r.status_code == 302
+    s = c.get("/links/OLDCODE/stats").json()
+    assert s == {"code": "OLDCODE", "url": "https://old.example/", "clicks": 8, "expires_at": None}
--- baseline/README.md
+++ proposed/README.md
@@ -0,0 +1,28 @@
+# URL Shortener
+
+FastAPI + SQLite URL shortener.
+
+## Setup
+
+Requires Python 3 with `fastapi`, `uvicorn` (to serve), `pytest` and `httpx` installed.
+
+## Environment
+
+- `SHORTENER_DB`: path of the SQLite database file (default `shortener.db`).
+  Existing databases are migrated automatically on startup (adds a nullable
+  `expires_at` column; existing links never expire).
+
+## Run
+
+    SHORTENER_DB=shortener.db uvicorn app.main:create_app --factory
+
+## API
+
+- `POST /links` body `{"url": "https://...", "ttl_seconds": 60}`; `ttl_seconds` is optional
+  and must be an integer from 1 to 86400. Returns 201 with `code`, `short_url`, `url`.
+- `GET /r/{code}` returns 302, or 404 when unknown or expired (now >= expires_at).
+- `GET /links/{code}/stats` returns `code`, `url`, `clicks`, `expires_at` (null if none).
+
+## Tests
+
+    pytest
